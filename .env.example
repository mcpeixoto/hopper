# Hopper configuration. Copy to .env and edit.
# Generate tokens with: openssl rand -hex 32

# ---- Control plane (hopperd) ----
HOPPER_PORT=8080
HOPPER_DB_PATH=data/hopper.db
HOPPER_ARTIFACT_DIR=data/artifacts
# Bearer token operators/clients use to SUBMIT jobs and view the dashboard.
HOPPER_OPERATOR_TOKEN=
# Bearer token worker NODES use to claim/complete jobs.
HOPPER_NODE_TOKEN=
# Browser origins allowed to call the API (the web console).
HOPPER_CORS_ORIGINS=http://localhost:5173
# Visibility timeout (s) for a claimed job, and long-poll hold time (s).
HOPPER_LEASE_SECONDS=120
HOPPER_LONGPOLL_SECONDS=25
# Per-IP rate limit for job submission + webhook (requests/min; 0 = unlimited).
HOPPER_SUBMIT_RPM=0
# Logging: debug|info|warn|error and text|json.
HOPPER_LOG_LEVEL=info
HOPPER_LOG_FORMAT=text

# ---- GitHub Actions runners (optional; see docs/github-actions.md) ----
# Set a token to enable running CI jobs on the fleet.
HOPPER_GITHUB_TOKEN=
HOPPER_GITHUB_WEBHOOK_SECRET=
HOPPER_RUNNER_IMAGE=myoung34/github-runner:latest
HOPPER_RUNNER_TRIGGER_LABELS=self-hosted,hopper
HOPPER_RUNNER_JOB_LABELS=ci

# ---- Worker agent (hopper-agent) ----
# Where the control plane lives (workers only need OUTBOUND access to this).
HOPPER_CONTROL_URL=http://localhost:8080
HOPPER_NODE_TOKEN=
# Comma-separated capabilities this node advertises (matched against job labels).
HOPPER_LABELS=
# Image pull policy: if-not-present | always
HOPPER_PULL_POLICY=if-not-present
# Set to 1 to give job containers network access (default: --network none).
HOPPER_ALLOW_NET=
# Optional docker resource caps per job.
HOPPER_CPU=
HOPPER_MEM=
# Local node GUI / status API bind address (loopback only).
HOPPER_AGENT_ADDR=127.0.0.1:8765
# Per-job scratch directory root.
HOPPER_WORK_ROOT=data/work
# Set to 1 to enable self-update to the latest published release.
HOPPER_AUTOUPDATE=
